{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/telegram/trigger-scan",
      "schedule": "45 3 * * 1-5"
    },
    {
      "path": "/api/telegram/trigger-cas",
      "schedule": "45 9 * * 1-5"
    }
  ]
}
